# Public number only. Included in browser JS at build time; NEVER put secrets here.
NEXT_PUBLIC_KHOSHVISA_WHATSAPP_NUMBER=

# Vercel serverless Node.js functions: the following are SERVER-ONLY secrets.
# Must match the public site's exact browser Origin (not a new subdomain).
PUBLIC_ORIGIN=https://khoshvisa.ir
ADMIN_EMAIL=
ADMIN_PASSWORD_SCRYPT=
SESSION_SECRET=

# Dedicated PostgreSQL database running on your VPS / Coolify.
# Do not reuse other project databases. Do not use 127.0.0.1 as Vercel cannot access VPS loopback.
# Enable a vetted network path with verified TLS + restrictive firewall (e.g. Vercel Static IPs allowlist
# or Secure Compute). PostgreSQL port must NOT be opened indiscriminately to the Internet.
DATABASE_URL=
# Optional: PEM CA certificate for mutual TLS/server authentication.
# Store as a Vercel secret with literal newlines or \n. Never NEXT_PUBLIC_.
PG_TLS_CA_PEM=

# Official Meta WhatsApp Business Platform webhook; not required for manual lead intake.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=

# Operator-only SQL maintenance scripts:
RETENTION_DAYS=180

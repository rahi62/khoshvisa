# Public WhatsApp Business number only (E.164 digits without '+' or separators).
# Example format: 98912XXXXXXX — replace with the CONFIRMED business number.
# Do not use a personal, test or unverified number.
NEXT_PUBLIC_KHOSHVISA_WHATSAPP_NUMBER=


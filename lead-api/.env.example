NODE_ENV=production
# Dedicated PostgreSQL database: only local/private VPS access. Never share Cafino's DB.
DATABASE_URL=postgresql://khoshvisa_leads_app:<strong-secret>@127.0.0.1:5432/khoshvisa_leads
# Exact HTTPS public origin for admin CSRF checks (Nginx proxy); no trailing slash.
PUBLIC_ORIGIN=https://leads.khoshvisa.ir
# Long random secret (at least 32 bytes) used to sign 8-hour admin session cookies.
SESSION_SECRET=
# Only an operator mailbox and scrypt hashed password; never commit plaintext password.
ADMIN_EMAIL=
ADMIN_PASSWORD_SCRYPT=
# Meta WhatsApp Business Cloud API server secrets.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
# No API token needed for inbound webhook reception.
RETENTION_DAYS=180
